<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container py-5">
    <div class="card shadow-sm p-4 max-w-lg mx-auto rounded-4" style="max-width: 500px;">
        <h3 class="fw-bold mb-3">Xin chào, <%= user.user_metadata.full_name || user.email %>! 👋</h3>
        <p class="text-muted">Bạn đã đăng nhập thành công vào hệ thống Express + Supabase.</p>
        <div class="bg-light p-3 rounded mb-4 border">
            <small><strong>User ID:</strong> <%= user.id %></small><br>
            <small><strong>Email:</strong> <%= user.email %></small>
        </div>
        <a href="/api/auth/logout" class="btn btn-danger w-100 fw-bold">Đăng Xuất</a>
    </div>
</div>
</body>
</html>