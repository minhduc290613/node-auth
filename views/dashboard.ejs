<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script>
        window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
</head>
<body class="bg-light">
<div class="container py-5">
    <div class="card shadow-sm p-4 max-w-lg mx-auto rounded-4" style="max-width: 500px;">
        <h3 class="fw-bold mb-3">Welcome, <%= user.user_metadata?.full_name || user.email %>!</h3>
        <p class="text-muted">You are signed in to the Express + Supabase application.</p>
        <div class="bg-light p-3 rounded mb-4 border">
            <small><strong>User ID:</strong> <%= user.id %></small><br>
            <small><strong>Email:</strong> <%= user.email %></small>
        </div>
        <% if (isAdmin) { %>
        <a href="/admin" class="btn btn-outline-primary w-100 fw-bold mb-3">Admin page</a>
        <% } %>
        <a href="/api/auth/logout" class="btn btn-danger w-100 fw-bold">Sign Out</a>
    </div>
</div>
</body>
</html>
