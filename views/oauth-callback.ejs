<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signing in</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <main class="container min-vh-100 d-flex align-items-center justify-content-center">
        <section class="card shadow-sm p-4 text-center" style="max-width: 440px; width: 100%;">
            <h1 class="h4 mb-3">Completing GitHub sign-in</h1>
            <p id="status" class="text-muted mb-0" role="status">Please wait...</p>
        </section>
    </main>
    <script>
      const status = document.getElementById('status');
      const fragment = new URLSearchParams(window.location.hash.slice(1));
      const accessToken = fragment.get('access_token');
      const oauthError = new URLSearchParams(window.location.search).get('error_description');
      window.history.replaceState(null, '', window.location.pathname);

      const fail = (message) => {
        status.textContent = message;
        status.classList.add('text-danger');
      };

      if (oauthError) {
        fail(oauthError);
      } else if (!accessToken) {
        fail('GitHub sign-in did not return an access token. Please try again.');
      } else {
        fetch('/api/auth/oauth-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ access_token: accessToken })
        })
          .then(async response => {
            const result = await response.json();
            if (!response.ok || !result.success) {
              throw new Error(result.message || 'GitHub sign-in could not be verified.');
            }
            window.location.replace('/dashboard');
          })
          .catch(error => fail(error.message));
      }
    </script>
</body>
</html>
